# ---------------------------------------------------------------------------
# Environment contract for the blog platform.
#
# Copy to .env and adjust. .env is git-ignored and must never be committed.
#   cp .env.example .env
#
# The backend reads these values through app/core/config.py (pydantic-settings);
# no other module reads the environment directly. Frontend variables prefixed
# with NEXT_PUBLIC_ are inlined into the client bundle at build time, so they
# must never hold a secret.
# ---------------------------------------------------------------------------

# ======================= Backend: database ================================
# Async SQLAlchemy URL. The psycopg 3 driver serves both the application
# (async) and Alembic (sync); no second driver is used.
# Host port is published by docker-compose (see POSTGRES_PORT below).
DATABASE_URL=postgresql+psycopg://blog:blog@localhost:5432/blog

# Separate database used by the backend test suite.
TEST_DATABASE_URL=postgresql+psycopg://blog:blog@localhost:5432/blog_test

# ======================= Backend: authentication ==========================
# HMAC signing key. MUST be at least 32 characters: PyJWT raises
# InsecureKeyLengthWarning below that (RFC 7518 section 3.2) and startup
# validation rejects it. Generate a fresh one per environment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-value-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ======================= Backend: service configuration ===================
# Comma-separated browser origins allowed to call the API (CORSMiddleware).
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# development | staging | production - selects console vs JSON logging and
# whether the interactive documentation routes are exposed.
ENVIRONMENT=development
LOG_LEVEL=INFO
# Rate-limit expression applied to the authentication routes (slowapi syntax).
AUTH_RATE_LIMIT=10/minute

# ======================= Backend: seed data ===============================
# Administrator account created by `python -m app.db.seed`.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password

# ======================= Frontend =========================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Modern Blog

# ======================= Local infrastructure (docker compose) ============
# Consumed by docker-compose.yml only.
POSTGRES_USER=blog
POSTGRES_PASSWORD=blog
POSTGRES_DB=blog
POSTGRES_PORT=5432
# Set COMPOSE_PROJECT_NAME (and a distinct POSTGRES_PORT) when several clones
# of this repository must run their own database side by side, e.g.
#   COMPOSE_PROJECT_NAME=blog-$CLONE_INDEX POSTGRES_PORT=$((5432 + CLONE_INDEX))
# COMPOSE_PROJECT_NAME=blog
