# =============================================================================
# .env.example - the configuration contract for the blog platform.
#
# Fourteen variables span the two tiers, and these fourteen are the whole of the
# configuration the application reads. Nothing is hard-coded: no secret, no
# connection string and no origin list appears anywhere in the source tree.
#
# How to use it
#   cp .env.example .env                 # backend and docker compose (repo root)
#   cp .env.example frontend/.env.local  # Next.js loads env files from its own
#                                        # project directory, not the repo root
#
# .env and .env.local are git-ignored; this example is the only environment file
# that is ever committed, so every value below is a PLACEHOLDER. They are chosen
# to work against the local docker compose stack out of the box, and every one of
# them must be changed for any non-local use.
#
# Who reads what
#   backend   backend/app/core/config.py is the ONLY module that reads the
#             environment (pydantic-settings). Every other module imports the
#             settings object from it, so this file is the single contract.
#   frontend  the three NEXT_PUBLIC_ values are inlined into the client bundle at
#             build time and are therefore public. Never give a secret that prefix.
#   compose   docker compose reads the repository-root .env automatically. It
#             declares its own defaults for the PostgreSQL container, so no
#             container-only variable belongs in this contract - see the header
#             of docker-compose.yml for the overrides parallel checkouts need.
#
# Format: KEY=value, one per line, no `export`, no spaces around `=`. Values are
# unquoted except where one contains a space (only NEXT_PUBLIC_SITE_NAME does),
# which keeps the file loadable by pydantic-settings, by docker compose and by
# `set -a; . ./.env; set +a` alike.
# =============================================================================


# -----------------------------------------------------------------------------
# BACKEND (11 variables) - read by backend/app/core/config.py
# -----------------------------------------------------------------------------

# --- Database ----------------------------------------------------------------

# PostgreSQL 18 connection URL. The scheme MUST be postgresql+psycopg://, because
# psycopg 3 is the single driver in this project: it serves both the async
# application engine and the synchronous engine Alembic drives. Do not use
# postgresql:// (SQLAlchemy resolves that to psycopg2, which is not installed) or
# postgresql+asyncpg:// (asyncpg is deliberately not a dependency).
# The placeholder user, password, port and database match the defaults
# docker-compose.yml gives its `db` service, so `docker compose up -d db` and this
# URL agree without further editing. They are local placeholders, not credentials.
# Run the test suite against a SEPARATE database: the contract is these fourteen
# keys, so a test run points DATABASE_URL at another database (blog_test, say)
# rather than introducing a fifteenth variable.
DATABASE_URL=postgresql+psycopg://blog:blog@localhost:5432/blog

# --- Authentication ----------------------------------------------------------

# HMAC key that signs every access and refresh token.
# HARD REQUIREMENT: at least 32 characters. Startup validation rejects anything
# shorter and the service refuses to boot, because PyJWT raises
# InsecureKeyLengthWarning for HMAC keys below 32 bytes, citing RFC 7518 s3.2.
# The placeholder clears that floor so a freshly copied file starts, but it is
# published in this repository and therefore worthless as a secret. Generate a
# unique value per environment and never reuse one:
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-change-me-change-me-change-me

# Token signing algorithm. HS256 is the documented default and is what the single
# symmetric key above supports; an RS or ES algorithm would need a key pair.
JWT_ALGORITHM=HS256

# Access-token lifetime, in minutes. Deliberately short: an access token is a
# bearer credential that cannot be withdrawn before it expires.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh-token lifetime, in days. Refresh tokens rotate on every use and are
# stored only as hashes, so this bounds an idle session rather than an active one.
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Cross-origin access -----------------------------------------------------

# Browser origins permitted to call the API, COMMA-SEPARATED - not JSON, not
# space-separated. Each entry is a complete origin: scheme, host and port, with
# no path and no trailing slash. Both loopback spellings are listed because the
# development server advertises localhost while the end-to-end runner drives
# 127.0.0.1, and a browser treats those as different origins.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Observability -----------------------------------------------------------

# development | staging | production. This has TWO effects and the second is a
# security boundary: it selects console-readable versus JSON structured logging,
# AND it decides whether the interactive documentation routes (/docs, /redoc,
# /openapi.json) are exposed. Never leave it at development in a deployment.
ENVIRONMENT=development

# Logging threshold: CRITICAL | ERROR | WARNING | INFO | DEBUG.
LOG_LEVEL=INFO

# --- Rate limiting -----------------------------------------------------------

# Limit applied to the authentication routes, as a slowapi/limits expression:
# "<count>/<period>", where period is second, minute, hour or day - for example
# 10/minute or 100/hour. Several limits may be combined with a semicolon, as in
# 10/minute;100/hour.
AUTH_RATE_LIMIT=10/minute

# --- Seed data ---------------------------------------------------------------

# Administrator account created by `make seed` (python -m app.db.seed). Seeding is
# idempotent, so re-running it will not overwrite an account that already exists:
# set both values before the first seed run rather than after it.
SEED_ADMIN_EMAIL=admin@example.com

# CHANGE THIS. It is the password of the only ADMIN principal the seed creates,
# and a committed placeholder is public knowledge. Never seed anything but a local
# database with the value below.
SEED_ADMIN_PASSWORD=ChangeMe-Admin-Password-1


# -----------------------------------------------------------------------------
# FRONTEND (3 variables) - read by Next.js at build time
#
# Copy this block into frontend/.env.local, because Next.js loads env files from
# its own project directory. The NEXT_PUBLIC_ prefix inlines each value into the
# client bundle, so all three are public by design and none may ever hold a
# secret. Both tiers share this one file, so the backend settings model must
# IGNORE the keys it does not declare: pydantic-settings defaults to rejecting
# unknown keys read from an env file, which would refuse the block below.
# -----------------------------------------------------------------------------

# Base URL of the REST API. It INCLUDES the /api/v1 prefix and carries no trailing
# slash, because frontend/src/lib/api/client.ts appends bare resource paths such
# as /posts to it. Repeating the prefix in client code would request
# /api/v1/api/v1/posts, so the prefix lives here and only here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Canonical site origin. It must be absolute, must carry a scheme and must NOT end
# in a slash: metadataBase, every canonical link, each sitemap entry and the
# BlogPosting/Person structured data are all built by joining paths onto it, so a
# stray trailing slash corrupts every URL a crawler is given.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Site name used by the title template and the social cards. Quoted because the
# value contains a space; the shell, python-dotenv, Node and docker compose all
# strip the quotes.
NEXT_PUBLIC_SITE_NAME="Modern Blog"
